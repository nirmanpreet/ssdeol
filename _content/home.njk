{# --------------------------------------------------------------- services #}
<section class="section" data-reveal>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">What we do</p>
      <h2>Commercial and industrial painting, end to end</h2>
      <p class="lede">
